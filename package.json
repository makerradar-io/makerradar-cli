{
  "name": "makerradar",
  "version": "0.4.0",
  "mcpName": "io.makerradar/mcp",
  "description": "Official MakerRadar CLI: search the launch directory and manage your listings from the terminal.",
  "keywords": [
    "makerradar",
    "cli",
    "launch platform",
    "product launch",
    "product directory",
    "startup directory",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai agents"
  ],
  "homepage": "https://makerradar.io/cli",
  "bugs": "https://github.com/makerradar-io/makerradar-cli/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makerradar-io/makerradar-cli.git"
  },
  "license": "MIT",
  "author": "MakerRadar (https://makerradar.io)",
  "type": "module",
  "bin": {
    "makerradar": "bin/makerradar.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:contract": "MAKERRADAR_CONTRACT=1 node --test test/contract.test.js",
    "prepublishOnly": "npm test",
    "sync:server-json": "node scripts/sync-server-json.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "check:skills": "node scripts/sync-skills.mjs --check",
    "version": "node scripts/sync-server-json.mjs && git add server.json plugin.json .claude-plugin/plugin.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
